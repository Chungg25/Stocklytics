# Public HTTPS URL of this service (Telegram webhook + /connect page).
PUBLIC_BASE_URL=https://bot.example.com

# Postgres / Supabase connection string (SQLite works for local testing).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Real-time quotes — free key at https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_CALLS_PER_MINUTE=55
# Intraday prices older than this are never used for alerts.
MAX_QUOTE_AGE_SECONDS=300

# Manager bot (create with @BotFather, then enable "Bot Management" for it in @BotFather).
MANAGER_BOT_TOKEN=
MANAGER_BOT_USERNAME=StocklyticsHubBot
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Encrypts users' bot tokens at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Hermes image built from ./hermes (docker build -t stocklytics/hermes-trader:latest hermes)
HERMES_IMAGE=stocklytics/hermes-trader:latest
HERMES_MEM_LIMIT=768m

CHECK_INTERVAL_MINUTES=30
ENABLE_SCHEDULER=true
